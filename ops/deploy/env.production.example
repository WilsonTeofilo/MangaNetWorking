# Modelo de ambiente de produção (sem segredos)

> Este arquivo é um **modelo**. Nenhum valor aqui é um segredo de produção: o `.env` real fica
> fora do Git, com permissões restritas, idealmente gerado por cofre/KMS.

# --- Banco relacional (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
SPRING_DATA_MONGODB_URI=mongodb://<user>:<senha-urlencode>@mongodb:27017/manganetworking_events?authSource=admin
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- Cache/filas (Redis) ---
REDIS_PASSWORD=

# --- Cifra de application.yml ---
# AES-256: 32 bytes em base64. Guardar no cofre; rotacionar exige plano de recriptografia.
AES_SECRET_KEY=
# HMAC dos desafios OTP: no minimo 32 caracteres, diferente do valor de desenvolvimento.
OTP_HMAC_SECRET=
# Segredo do webhook de bounce do provedor de e-mail (>=32 caracteres).
EMAIL_WEBHOOK_SECRET=
# Token de coleta de metricas pelo Prometheus (>=32 caracteres).
METRICS_SCRAPE_TOKEN=

# --- E-mail (SMTP autenticado) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=MangaNetWorking
# Link de recuperacao de senha (HTTPS, sem path/query/fragment)
PUBLIC_FRONTEND_URL=https://<dominio-publico>
# Origem do checkout do Mercado Pago (padrao: PUBLIC_FRONTEND_URL)
MERCADOPAGO_BACK_URL_BASE=https://<dominio-publico>
# Origens liberadas no CORS (padrao: PUBLIC_FRONTEND_URL)
CORS_ALLOWED_ORIGINS=https://<dominio-publico>

# --- Pagamento (homologacao antes de producao) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://<dominio-publico>/api/monetization/mercadopago/webhook

# --- Outros ---
# TTL do link de recuperacao de senha (5 a 60 minutos; padrao PT30M)
PASSWORD_RESET_TOKEN_TTL=PT30M
# Versao da politica de privacidade exigida no aceite
PRIVACY_POLICY_VERSION=2026-10-v1
# Caminho do texto oficial da politica aprovada (fora do repositorio)
PRIVACY_POLICY_DOCUMENT=/run/legal/2026-10-v1.md
