# Configuração do MangaNetWorking Backend
# Copie este arquivo para .env e ajuste os valores

# === Banco de Dados (PostgreSQL) ===
# Credenciais para desenvolvimento local (docker-compose)
POSTGRES_PASSWORD=manga_dev_local_secure_2026

# Conexão JDBC para o backend Spring
# O backend importa este arquivo via spring.config.import (application.yml).
# Não use comentários na mesma linha de um valor: o Spring lê o "#" como parte do valor.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:25432/manganetworking
SPRING_DATASOURCE_USERNAME=postgres
# Use uma senha diferente da POSTGRES_PASSWORD se necessário:
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# === Banco NoSQL (MongoDB) ===
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/manganetworking_events

# === Criptografia (Produção OBRIGATÓRIO) ===
# Chave AES-256 para dados sensíveis (CPF/PIX de criadores)
# Mínimo 32 caracteres ASCII. Use openssl rand -base64 32 para gerar.
AES_SECRET_KEY=

# === CORS ===
# Origens autorizadas separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5180,http://127.0.0.1:5173,http://127.0.0.1:3000

# === Storage ===
UPLOAD_DIR=./data/uploads
STORAGE_MAX_FILE_SIZE_MB=15

# === E-mail / 2FA (SMTP) ===
# PLATFORM_MAIL_ENABLED=true usa SMTP real; false usa o DevOutbox (perfis dev/test/local).
# Para testes locais, aponte para o Mailpit (http://localhost:8025) sem autenticação.
PLATFORM_MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=nao-responda@manganetworking.com
MAIL_FROM_NAME=MangaNetWorking

# === Mercado Pago ===
# Use credenciais TEST- em desenvolvimento. O .env nunca deve ser commitado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BACK_URL_BASE=http://localhost:5180

# === Profiles Spring Boot ===
# Para desenvolvimento local com endpoint de outbox 2FA
# SPRING_PROFILES_ACTIVE=dev

# === Logging (opcional) ===
# LOGGING_LEVEL_COM_MANGANETWORKING=DEBUG